# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Optional: port the backend listens on (default 3000)
# PORT=3000

# Optional: address of the frontend, allowed to call this backend from the browser (default below)
# FRONTEND_ORIGIN=http://localhost:5173

# Ethereum Mainnet JSON-RPC endpoint (HTTPS). Get one from https://dashboard.alchemy.com
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Firebase Admin SDK service-account key file. Keep it in backend/secrets/ (ignored by Git).
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
